      "position": [
        1050,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "690113bb-b35a-44c6-a092-c0877be87151",
              "name": "email",
              "value": "={{ $json.rows[0].email.toLowerCase().trim() }}",
              "type": "string"
            },
            {
              "id": "07f0f97d-4ab5-46b6-8df2-48bc73c50c1b",
              "name": "phone",
              "value": "={{ $json.rows[0].phone.replace(/\\D/g,'') }}",
              "type": "string"
            },
            {
              "id": "83829552-5c51-4cef-a93b-4f5e09de0b91",
              "name": "name",
              "value": "={{ $json.rows[0].name.trim().replace(/\b\\w/g, c => c.toUpperCase()) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
