      "name": "Parse CSV",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4c0cd66d-330c-4355-bf4c-535d6f09f68c",
              "name": "rows",
              "value": "={{ $json.body.rows }}",
