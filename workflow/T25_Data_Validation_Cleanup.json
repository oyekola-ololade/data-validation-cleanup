        "options": {}
      }
    },
    {
      "id": "f1ec9bfd-cbef-490f-a5df-a07fbaa8352e",
      "name": "Validate Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        650,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a8b6d3be-33f5-4027-9fb7-f4b2c981c477",
              "name": "email_valid",
              "value": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.rows[0].email) }}",
              "type": "string"
            },
            {
              "id": "b4e90974-6e95-495d-99d1-4108ef245f36",
              "name": "phone_valid",
              "value": "={{ /^\\d{10,15}$/.test($json.rows[0].phone.replace(/\\D/g,'')) }}",
              "type": "string"
            },
            {
              "id": "3032ae66-f891-48c4-bf1c-db93db0fbf70",
              "name": "date_valid",
              "value": "={{ !isNaN(new Date($json.rows[0].date)) }}",
              "type": "string"
            },
            {
              "id": "7dbd888f-c50b-43ce-9b44-85ce849aad5b",
              "name": "row_data",
              "value": "={{ JSON.stringify($json.rows[0]) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6f6b70db-e612-4993-8520-04977789d390",
      "name": "Row Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4a8c809e-ca85-4bcc-8d49-868170bbe671",
              "leftValue": "={{ $json.email_valid && $json.phone_valid && $json.date_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "360ec99b-6d59-47d9-8df1-d26faf3b0d57",
      "name": "Clean Data",
      "type": "n8n-nodes-base.set",
